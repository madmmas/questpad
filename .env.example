# Postgres connection string (Neon, via Vercel Marketplace integration)
DATABASE_URL=

# Vercel Blob (image storage) — set automatically when the Blob store
# is linked to your Vercel project; needed locally for `vercel env pull`
BLOB_READ_WRITE_TOKEN=

# Auth.js
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Claude API (optional AI review of submissions)
ANTHROPIC_API_KEY=

# Telegram Bot API (parent notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
