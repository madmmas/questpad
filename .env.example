# Postgres connection string (Neon in production, or local Docker Compose)
# Compose app service uses db:5432 internally. From the host:
#   postgresql://questpad:questpad@localhost:5433/questpad
DATABASE_URL=

# Force the Drizzle driver: neon-http | postgres
# Default: neon-http for *.neon.tech hosts, postgres for localhost/db.
# Docker Compose sets DATABASE_DRIVER=postgres.
DATABASE_DRIVER=

# Vercel Blob (image storage) — set automatically when the Blob store
# is linked to your Vercel project; needed locally for `vercel env pull`.
# Leave empty for the local uploads/ disk fallback.
BLOB_READ_WRITE_TOKEN=

# Demo fake-login (issue #32). Defaults match these values if unset.
AUTH_SECRET=dev-auth-secret-change-me
DEMO_PARENT_USER=parent
DEMO_PARENT_PASSWORD=parent123
DEMO_CHILD_USER=child
DEMO_CHILD_PASSWORD=child123

# Demo DB seed (issue #34). Required for `npm run db:seed` / `make demo-seed`.
# Never set in production. Remote Neon hosts also need DEMO_SEED_ALLOW_REMOTE=1.
ALLOW_DEMO_SEED=
DEMO_SEED_ALLOW_REMOTE=

# Auth.js (reserved for a later real PIN flow)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Claude API (optional AI review of submissions)
ANTHROPIC_API_KEY=

# Telegram Bot API (parent notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
